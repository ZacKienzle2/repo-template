{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enablePreCommit"],
  "git-submodules": {
    "enabled": true
  },
  "github-actions": {
    "managerFilePatterns": ["/(^|/)\\.github/workflows/.+\\.jinja$/"]
  },
  "pre-commit": {
    "managerFilePatterns": ["/(^|/)\\.pre-commit-config\\.yaml\\.jinja$/"]
  }
}
