{#- prettier's defaults are the base. The widths are the template's, so
    .editorconfig and the editor rulers state the same numbers. -#}
proseWrap: always
printWidth: {{ prose_width }}
overrides:
  - files: ["*.yml", "*.yaml", ".clang-*", "*.cff"]
    options:
      printWidth: {{ data_width }}
  # The VS Code files are serialised by Jinja's tojson with an indent of 2,
  # which prints as JSON.stringify does. prettier's json-stringify parser keeps
  # that whitespace, where the json parser folds a short array onto one line
  # and copier update then conflicts on the folded lines.
  - files: [".vscode/*.json"]
    options:
      parser: json-stringify
