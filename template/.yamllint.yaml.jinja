extends: default

rules:
  line-length:
    max: 140
    level: warning
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  indentation:
    spaces: 2
    indent-sequences: consistent

ignore: |
  node_modules/
  .git/
  .venv/
  dist/
  build/
  .pytest_cache/
  .ruff_cache/
  __pycache__/
{%- if has_cpp %}
  # clang keeps its own configuration in these, and their formatting is clang's
  # convention rather than this project's: .clang-tidy writes CheckOptions as
  # inline maps with spaces inside the braces, and .clang-format uses Yes and No
  # where yamllint wants true and false. Both are YAML by shape only.
  .clang-tidy
  .clang-format
{%- endif %}
