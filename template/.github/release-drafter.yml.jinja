# Rendered by copier from commit_types in copier.yml. Release Drafter v7 reads
# the Conventional Commits header of each pull request title itself, so every
# category names the types it collects and the version increment they carry,
# and no label or autolabeler stands in for the type. Categories are evaluated
# in order: an excluded change is dropped first, and a breaking change or a
# dependency update is filed once, under its own heading, before the types.
name-template: "v$RESOLVED_VERSION"
tag-template: "v$RESOLVED_VERSION"

categories:
  - type: pre-exclude
    when:
      label: "skip-changelog"
  - title: "Breaking Changes"
    semver-increment: major
    exclusive: true
    when:
      - conventional:
          breaking: true
      - label: "breaking"
  - title: "Dependencies"
    exclusive: true
    when:
      label: "dependencies"
  # % for title in commit_types | map(attribute="title") | unique
  # % set group = commit_types | selectattr("title", "equalto", title) | list
  - title: "(( title ))"
    semver-increment: (( group | map(attribute="bump") | first ))
    when:
      conventional:
        types: (( group | map(attribute="type") | list | tojson ))
  # % endfor
  # A version resolver without a condition is the documented fallback: a
  # title no category matches still resolves to a patch release.
  - type: version-resolver
    semver-increment: patch

change-title-escapes: '\<*_&'

template: |
  ## What's Changed

  $CHANGES

  ## Contributors

  $CONTRIBUTORS

  **Full Changelog**: https://github.com/$OWNER/$REPOSITORY/compare/$PREVIOUS_TAG...v$RESOLVED_VERSION
