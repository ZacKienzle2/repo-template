{#- Rendered from commit_types in copier.yml plus the labels the workflows
    and the labeler name. GitHub's own defaults (bug, enhancement,
    documentation, question and the rest) exist on every repository and are
    left alone; the size and stale labels are created by the actions that
    apply them; labels-sync no longer deletes what this file does not list. -#}
# Rendered by copier from the commit types in copier.yml, which the release
# drafter and its autolabeler read as well.
{%- for t in commit_types %}
- name: "{{ t.type }}"
  color: "{{ t.color }}"
  description: "Conventional Commits type: {{ t.type }}"
{%- endfor %}
- name: "breaking"
  color: "b60205"
  description: "Breaking change; a major bump"
- name: "dependencies"
  color: "0366d6"
  description: "Dependency update"
- name: "security"
  color: "ee0701"
  description: "Security-related"
- name: "github-config"
  color: "0366d6"
  description: "Repository configuration under .github/"
- name: "skip-changelog"
  color: "ededed"
  description: "Left out of the release notes"
- name: "pinned"
  color: "0052cc"
  description: "Exempt from the stale bot"
- name: "blocked"
  color: "b60205"
  description: "Blocked on a dependency or a decision; exempt from the stale bot"
- name: "work-in-progress"
  color: "fbca04"
  description: "Not ready for review; exempt from the stale bot"
{#- Language labels follow the answers; the colours are linguist's for each
    language, which is what GitHub paints the repository's language bar with. -#}
{%- if has_cpp %}
- name: "cpp"
  color: "f34b7d"
  description: "C++ sources and the CMake build"
{%- endif %}
{%- if has_python %}
- name: "python"
  color: "3572a5"
  description: "Python sources"
{%- endif %}
{%- if has_node %}
- name: "javascript"
  color: "f1e05a"
  description: "JavaScript and TypeScript sources"
{%- endif %}
{%- if has_latex %}
- name: "latex"
  color: "3d6117"
  description: "LaTeX sources"
{%- endif %}
