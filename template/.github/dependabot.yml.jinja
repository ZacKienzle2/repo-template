{#- One cadence for every ecosystem, through a macro, so the entries cannot
    drift apart as the pre-commit one once had. Which ecosystems follow the
    answers. Every update carries the dependencies label, which the release
    drafter files under its own heading. -#}
{%- macro cadence() %}
    schedule:
      interval: "weekly"
      day: "monday"
      time: "06:00"
      timezone: "Etc/UTC"
    cooldown:
      default-days: 7
{%- endmacro -%}
version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"{{ cadence() }}
    open-pull-requests-limit: 10
    commit-message:
      prefix: "ci"
      include: "scope"
    labels:
      - "dependencies"
    groups:
      actions-minor-and-patch:
        update-types:
          - "minor"
          - "patch"
  - package-ecosystem: "pre-commit"
    directory: "/"
{{ cadence() }}
    commit-message:
      prefix: "ci"
      include: "scope"
    labels:
      - "dependencies"
    groups:
      pre-commit-hooks:
        patterns: ["*"]
{%- if has_python %}
  - package-ecosystem: "uv"
    directory: "/"
{{ cadence() }}
    open-pull-requests-limit: 5
    commit-message:
      prefix: "build"
      include: "scope"
    labels:
      - "dependencies"
    groups:
      python-minor-and-patch:
        update-types:
          - "minor"
          - "patch"
{%- endif %}
{%- if has_node %}
  - package-ecosystem: "npm"
    directory: "/"
{{ cadence() }}
    open-pull-requests-limit: 5
    commit-message:
      prefix: "build"
      include: "scope"
    labels:
      - "dependencies"
    groups:
      npm-minor-and-patch:
        update-types:
          - "minor"
          - "patch"
{%- endif %}
