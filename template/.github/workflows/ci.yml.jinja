# The checks every repository runs on a pull request: the hooks over the
# whole tree, a history scan for secrets and the link checker, gated by one
# job whose name branch protection requires. Formatting, linting and schema
# checks live in .pre-commit-config.yaml and run here through the same
# hooks, so no check exists in two forms. Pull requests only: main is
# merged, not pushed, and a rebase merge lands the head that was checked.
name: CI

on:
  pull_request:
    branches: [main]
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  pre-commit:
    name: Run pre-commit hooks
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      # % if has_python
      # ~
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version-file: .python-version
      # % endif
      # ~
      # The official action installs pre-commit and caches the hook
      # environments on the configuration's hash, which is the recipe the
      # pre-commit documentation gives for continuous integration. Its default
      # is --all-files, so a hook added to the configuration is applied to the
      # whole tree by the change that adds it.
      - name: Run pre-commit
        uses: pre-commit/action@2c7b3805fd2a0fd8c1884dcaebf91fc102a13ecd # v3.0.1
        # % if has_python
        # pyright reads the project's synced environment, which the Python
        # workflow builds, so the hook runs there and pre-commit's SKIP variable
        # leaves it out of this job.
        env:
          SKIP: pyright
        # % endif
        # ~
  gitleaks:
    name: Scan for leaked secrets
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # The scan walks history, which needs all of it.
          fetch-depth: 0

      # The pre-commit hook scans what is staged, which is the right scan
      # while committing and finds nothing on a runner. This scans the
      # repository's history. The official action needs a licence key for
      # organisation accounts only.
      - name: Run gitleaks
        uses: gitleaks/gitleaks-action@e0c47f4f8be36e29cdc102c57e68cb5cbf0e8d1e # v3.0.0
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  link-check:
    name: Check Markdown links
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # The action's defaults are the whole configuration: it reads lychee.toml,
      # checks the Markdown, HTML and reStructuredText files quietly with the
      # workflow's token, and fails the job on a broken link.
      - name: Link checker
        uses: lycheeverse/lychee-action@e7477775783ea5526144ba13e8db5eec57747ce8 # v2.9.0
  # % if has_node
  # ~
  # The checks that need the project's own packages installed, which no hook
  # environment has: the type checker, the linters that load plugins and
  # configuration from node_modules, the build and the tests.
  node:
    name: Lint, type-check, build and test
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # setup-node reads the version from package.json, which every Node
      # repository has: volta.node, then devEngines.runtime, then engines.node.
      # The npm cache is keyed on package-lock.json. No build cache is kept:
      # this workflow runs on pull requests alone, and GitHub scopes a pull
      # request's cache to its merge ref, which no other pull request can
      # restore from.
      - name: Set up Node
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: package.json
          cache: npm

      - name: Install dependencies
        run: npm ci

      # The conventional script names, each run with --if-present, which npm
      # documents for a generic CI setup: a repository without one of them
      # skips that step. The build runs before the tests, since a test may read
      # what the build generates, and npm runs a postbuild script straight
      # after the build, which is where a check of the build output belongs.
      - name: Lint
        run: npm run lint --if-present

      - name: Type-check
        run: npm run typecheck --if-present

      - name: Build
        run: npm run build --if-present

      - name: Test
        run: npm test --if-present
  # % endif
  # ~
  ci-summary:
    name: CI summary gate
    runs-on: ubuntu-latest
    timeout-minutes: 2
    needs:
      - pre-commit
      - gitleaks
      - link-check
      # % if has_node
      - node
      # % endif
    if: always()
    steps:
      # re-actors/alls-green reads the needs context and fails on any failed
      # or cancelled job, so branch protection requires this one name rather
      # than every job above.
      - name: Decide whether the needed jobs succeeded
        uses: re-actors/alls-green@b5b5b37504aa4183270bd3d855c52a67f212be35 # v1.3.0
        with:
          jobs: ${{ toJSON(needs) }}
