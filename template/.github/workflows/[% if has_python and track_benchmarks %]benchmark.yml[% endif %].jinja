# Rendered only when track_benchmarks is answered true, the way the sanitizer
# workflow waits for a preset mapping. Without a benchmark in the repository
# pytest writes an empty report and the action has nothing to compare, so an
# unconditional file here would be a job that fails on every push.
name: Benchmark

# Only on main. The action stores each result on gh-pages and compares the new
# one against what is there, so a run from a pull request branch would write a
# history entry for a commit that may never land.
on:
  push:
    branches: [main]
  workflow_dispatch: {}

# contents: write is what lets the action commit the result to gh-pages. The
# other jobs in this repository read alone; this is the one that writes, and it
# writes to that branch only.
permissions:
  contents: write

concurrency:
  group: benchmark-${{ github.ref }}
  cancel-in-progress: true

jobs:
  benchmark:
    name: Benchmark
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # uv installs the interpreter .python-version names, and setup-uv caches
      # on the lock file by default.
      - name: Install uv
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0

      - name: Sync dependencies
        run: uv sync --frozen --all-extras

      # --benchmark-only skips the correctness tests, which run in the Python
      # workflow. A shared runner is noisy, so the threshold is wide enough
      # that only a real regression reaches it.
      - name: Run the benchmarks
        run: uv run pytest --benchmark-only --benchmark-json=benchmark.json

      - name: Compare against the last run on main
        uses: benchmark-action/github-action-benchmark@4322e5726e6334590d251fc4f92bec0efafc45dc # v1.22.2
        with:
          tool: pytest
          output-file-path: benchmark.json
          github-token: ${{ secrets.GITHUB_TOKEN }}
          auto-push: true
          alert-threshold: "150%"
          comment-on-alert: true
          fail-on-alert: true
