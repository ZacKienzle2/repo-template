{#- The test suite of a Python repository, run in the project's own
    environment from its lock file. Ruff, mypy and the other checks are hooks
    and run in the CI workflow, so nothing is run twice. pyright is the one hook
    that needs this environment, so it runs here through pre-commit, at the
    version .pre-commit-config.yaml pins, and the CI workflow skips it. A
    repository's other Python jobs, a notebook execution or a coverage upload to
    a service, are its own workflows beside this one. -#}
name: Python

on:
  pull_request:
    branches: [main]
    paths:
      - "**/*.py"
      - "**/*.pyi"
      - "pyproject.toml"
      - "uv.lock"
      - ".python-version"
      - ".pre-commit-config.yaml"
      - ".github/workflows/python.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: {% raw %}python-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  test:
    name: Test
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@ab7a9404c0f3da075243ca237b5fac12c98deaa5 # v2.19.3
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          persist-credentials: false

      # uv reads .python-version and installs that interpreter; the cache is
      # keyed on the lock file, which is what setup-uv documents.
      - name: Install uv
        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # v8.2.0
        with:
          enable-cache: true
          cache-dependency-glob: "uv.lock"

      - name: Sync dependencies
        run: uv sync --frozen --all-extras

      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version-file: .python-version

      - name: Type-check with pyright
        uses: pre-commit/action@2c7b3805fd2a0fd8c1884dcaebf91fc102a13ecd # v3.0.1
        with:
          extra_args: pyright --all-files

      - name: Run the test suite
        run: uv run pytest
