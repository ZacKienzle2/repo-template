{#- Runs when a version tag is pushed. release-drafter has been drafting the
    notes from pull request labels as they merged; here it publishes that
    draft under the tag. The SBOMs are anchore's, attested with GitHub's own
    provenance action and attached with the runner's gh, which is zizmor's
    remediation for a release action. Whether the tag is a prerelease is an
    expression on its name, and the trigger's pattern is what makes the name
    safe to pass on. -#}
name: Release

on:
  push:
    tags:
      - "v[0-9]+.[0-9]+.[0-9]+"
      - "v[0-9]+.[0-9]+.[0-9]+-*"

permissions:
  contents: read

concurrency:
  group: {% raw %}release-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
  release:
    name: Publish GitHub Release
    runs-on: ubuntu-latest
    timeout-minutes: 30
    # The write scopes sit on the job, with the workflow read-only, which is
    # the shape OpenSSF Scorecard's Token-Permissions check scores.
    permissions:
      contents: write
      pull-requests: read
      id-token: write
      attestations: write
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
{%- if has_generated_changelog %}

      - name: Regenerate the changelog
        uses: orhun/git-cliff-action@a9a95522b26fe6403f7bb24031f21fb573d0f5ff # v4.9.1
        with:
          config: cliff.toml
          args: {% raw %}--verbose --tag ${{ github.ref_name }}{% endraw %}
        env:
          OUTPUT: CHANGELOG.md
{%- endif %}

      - name: Generate SBOM (SPDX)
        uses: anchore/sbom-action@3ad7283483fc7af8ff2b4ea19663c2d5ca935e26 # v0.24.2
        with:
          path: .
          format: spdx-json
          output-file: sbom.spdx.json
          artifact-name: sbom.spdx.json
          upload-artifact: true
          upload-release-assets: false

      - name: Generate SBOM (CycloneDX)
        uses: anchore/sbom-action@3ad7283483fc7af8ff2b4ea19663c2d5ca935e26 # v0.24.2
        with:
          path: .
          format: cyclonedx-json
          output-file: sbom.cdx.json
          artifact-name: sbom.cdx.json
          upload-artifact: true
          upload-release-assets: false

      - name: Attest build provenance
        uses: actions/attest-build-provenance@ef244123eb79f2f7a7e75d99086184180e6d0018 # v1.4.4
        with:
          subject-path: |
            sbom.spdx.json
            sbom.cdx.json

      - name: Publish the drafted release
        uses: release-drafter/release-drafter@6a93d829887aa2e0748befe2e808c66c0ec6e4c7 # v6.4.0
        with:
          publish: true
          tag: {% raw %}${{ github.ref_name }}{% endraw %}
          name: {% raw %}${{ github.ref_name }}{% endraw %}
          prerelease: {% raw %}${{ contains(github.ref_name, '-') }}{% endraw %}
          commitish: {% raw %}${{ github.sha }}{% endraw %}
          disable-autolabeler: true
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Attach the SBOMs{% if has_generated_changelog %} and the changelog{% endif %}
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: gh release upload "$TAG" sbom.spdx.json sbom.cdx.json{% if has_generated_changelog %} CHANGELOG.md{% endif %} --clobber
