# Runtime checks for a C or C++ repository, one job per CMake workflow preset
# the repository answers with. Each preset chains the configure, build and
# test presets in the repository's CMakePresets.json, which carry the
# -fsanitize flags and the sanitizer runtime options. The repository's own
# .github/actions/setup-cpp installs the compiler and libraries and reports
# the compiler as its cc and cxx outputs, which reach CMake as CC and CXX, so
# this file names nothing but the preset and the compiler input.

# Sanitizers observe the execution itself, so they find bugs that static
# analysis misses (Song et al., doi:10.1109/sp.2019.00010). A ThreadSanitizer
# preset built with clang loads Archer from LLVM's OpenMP runtime, which
# annotates OpenMP synchronisation for race detection (Archer's README, and
# Atzeni et al., doi:10.1109/ipdps.2016.68). A push to main runs the job as
# well as a pull request, because a repository that commits to main directly
# would otherwise never run it. The paths filter is written under each
# trigger, since a macro's body would be YAML at the top of the source.
name: Sanitizers

on:
  pull_request:
    branches: [main]
    # % if cpp_source_dir not in [".", ""]
    paths:
      - "(( cpp_source_dir ))/**"
      - ".github/actions/setup-cpp/**"
      - ".github/workflows/sanitizers.yml"
    # % endif
  push:
    branches: [main]
    # % if cpp_source_dir not in [".", ""]
    paths:
      - "(( cpp_source_dir ))/**"
      - ".github/actions/setup-cpp/**"
      - ".github/workflows/sanitizers.yml"
    # % endif
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: sanitizers-${{ github.ref }}
  cancel-in-progress: true

jobs:
  sanitize:
    name: ${{ matrix.preset }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        include:
          # % for preset, compiler in cpp_sanitizer_presets.items()
          - preset: (( preset | tojson ))
            compiler: (( compiler | tojson ))
          # % endfor
    steps:
      - name: Harden runner
        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
        with:
          egress-policy: audit

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # The compiler travels as step outputs rather than through GITHUB_ENV,
      # which is how zizmor's github-env audit says to pass state between steps.
      - name: Install the compiler and libraries
        id: setup
        uses: ./.github/actions/setup-cpp # zizmor: ignore[self-repository] actionlint 1.7.12 rejects the $/ form (rhysd/actionlint#711, #732)
        with:
          compiler: ${{ matrix.compiler }}
          ccache-key: sanitizers-${{ matrix.preset }}

      - name: Configure, build and test
        working-directory: (( cpp_source_dir ))
        env:
          CC: ${{ steps.setup.outputs.cc }}
          CXX: ${{ steps.setup.outputs.cxx }}
          PRESET: ${{ matrix.preset }}
        run: cmake --workflow --preset "$PRESET"
