# markdownlint-cli2 finds this file by name, so the hook needs no --config, and
# it reads the generated ignore file rather than repeating what that lists.
gitignore: true
# The schema leaves fix off by default. On, the hook applies each rule's own
# fix, and prek fails the commit on the rewritten file, so each fix is
# reviewed in the diff.
fix: true
# % if has_generated_changelog
# ~
# CHANGELOG.md is git-cliff's rendering of the commit history, so a rule firing
# on it asks for an edit the next regeneration discards. .vale.ini gives it an
# empty BasedOnStyles for the same reason, and a generated file is exempted once
# rather than a rule at a time.
ignores:
  - CHANGELOG.md
# % endif
# ~
# Every rule is on unless disabled: markdownlint enables all rules when the
# configuration has no default key, so none is set.
config:
  MD013: false
  MD033: false
  MD041: false
  MD036: false

  MD024:
    siblings_only: true
  # % if has_generated_changelog
  # ~
  # A generated CHANGELOG.md carries the blank lines its template writes, so the
  # rule against consecutive ones would fail on every regeneration.
  MD012: false
  # % endif
# ~
# The MADR template marks every section optional except the problem statement,
# the considered options and the decision outcome, so MD043 requires those three
# in that order below the title of each numbered record. The filter leaves out
# the template and the README that MADR ships beside the records. An override
# applies only to files already in scope, so a repository without decision
# records is unaffected.
overrides:
  - filter:
      - "docs/adr/[0-9]*.md"
    combine: merge
    config:
      MD043:
        headings:
          - "?"
          - "## Context and Problem Statement"
          - "*"
          - "## Considered Options"
          - "*"
          - "## Decision Outcome"
          - "*"
