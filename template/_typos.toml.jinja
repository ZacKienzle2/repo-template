# Managed by copier from ZacKienzle2/repo-template. typos' defaults already
# skip lock files and certificates, whatever .gitignore names, and hidden
# files, so no path list repeats those. A repository's own vocabulary is the
# typos_words_own answer, rendered at the end.

# typos walks past a hidden file but checks any path it is handed, which is how
# the hook hands it .gitignore. The assembled file is a list of file extensions
# from github/gitignore, and some three-letter TeX ones read as words.
[type.gitignore]
extend-glob = [".gitignore", "*.gitignore"]
check-file = false

# .gitattributes is assembled the same way from gitattributes/gitattributes,
# whose Web block lists the four-letter Stylus extension, which typos reads as
# a misspelt "style".
[type.gitattributes]
extend-glob = [".gitattributes", "*.gitattributes"]
check-file = false
# % if has_generated_changelog
# ~
# A generated CHANGELOG.md carries short commit hashes as link text, and typos
# reads the letters in one as a word. A type of its own, unchecked, is typos'
# way to leave a generated file alone.
[type.changelog]
extend-glob = ["CHANGELOG.md"]
check-file = false
# % endif
# % if has_latex
# ~
# A .bib composed from registrar records carries author surnames, abbreviated
# journal titles and abstracts verbatim, so a spelling there is the registrar's
# to correct. A .bst is a BibTeX style program the TeX distribution ships, and
# the abbreviated journal titles in it are its data.
[type.bibtex]
extend-glob = ["*.bib"]
check-file = false

[type.bibtexstyle]
extend-glob = ["*.bst"]
check-file = false
# % endif
# % if has_cpp
# ~
# A Doxyfile is written by `doxygen -g` and its comments are Doxygen's own prose.
[type.doxyfile]
extend-glob = ["Doxyfile"]
check-file = false
# % endif
# % if has_latex
# ~
# A cross-reference or a citation carries a key rather than prose, and
# \Cref{lem:Name} reads as the word "lem". A key a registrar composes from an
# accented surname reads the same way once the accent is dropped. Matching the
# commands that take a key leaves the text around them checked, which a path
# exclusion would not.
[default]
extend-ignore-re = [
  '\\(?:label|ref|Cref|cref|eqref|autoref|nameref|pageref|pagenumbering)\{[^}]*\}',
  '\\(?:no)?cite[a-zA-Z]*\*?(?:\[[^\]]*\])*\{[^}]*\}',
  '\\(?:newtheorem|theoremstyle|AtBeginEnvironment|AtEndEnvironment)\{[^}]*\}',
  '\\(?:begin|end)\{(?:thm|lem|cor|prop|defn|rem)[^}]*\}',
  '\\frac\{[^}]*\}\{[^}]*\}',
]
# % endif
# % if typos_words_own
# ~
# This repository's own, the typos_words_own answer in .copier-answers.yml.
[default.extend-words]
# % for word in typos_words_own
(( word | tojson )) = (( word | tojson ))
# % endfor
# % endif
