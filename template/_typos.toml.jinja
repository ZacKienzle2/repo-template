{#- typos' own configuration. Its defaults already skip lock files and
    certificates, whatever .gitignore names, and hidden files, so no path list
    repeats those. A repository's vocabulary goes after this block under
    [default.extend-words] or [default.extend-identifiers], which copier
    update carries forward. -#}
# Managed by copier from ZacKienzle2/repo-template. A repository's own words go
# under [default.extend-words] after this block.

# typos walks past a hidden file but checks any path it is handed, which is how
# the hook hands it .gitignore. The assembled file is a list of file extensions
# from github/gitignore, and some three-letter TeX ones read as words.
[type.gitignore]
extend-glob = [".gitignore", "*.gitignore"]
check-file = false
{%- if has_generated_changelog %}

# A generated CHANGELOG.md carries short commit hashes as link text, and typos
# reads the letters in one as a word. A type of its own, unchecked, is typos'
# way to leave a generated file alone.
[type.changelog]
extend-glob = ["CHANGELOG.md"]
check-file = false
{%- endif %}
