# Assembled by copier from github/gitignore, the collection behind GitHub's
# own "add .gitignore" control. The template repository keeps upstream's
# files unedited, fetched by vendir at the commit its vendir.lock.yml records,
# and which of them apply follows the answers in .copier-answers.yml. Editor
# and operating system byproducts are absent on purpose: upstream keeps those
# under Global/ for a user's own core.excludesFile. A path only this
# repository produces is the gitignore_own answer, rendered at the end, so
# nothing in this file is written by hand.

# vale's StylesPath, which .vale.ini sets and the sync hook fills. vale's
# StylesPath and Packages pages say everything `vale sync` writes is rebuilt
# from Packages and that ignoring the whole StylesPath is simplest when none
# of it is the project's own.
.cache/
# % if has_python
# ~
[% filter trim %][% include "gitignore/Python.gitignore" %][% endfilter %]
# % endif
# % if has_cpp
# ~
[% filter trim %][% include "gitignore/C++.gitignore" %][% endfilter %]

[% filter trim %][% include "gitignore/CMake.gitignore" %][% endfilter %]
# % endif
# % if has_latex
# ~
[% filter trim %][% include "gitignore/TeX.gitignore" %][% endfilter %]
# % endif
# % if has_snakemake
# ~
# github/gitignore has no Snakemake template. The workflow catalog's own
# snakemake-workflow-template publishes this block, vendored unedited under
# snakemake-workflow-template/ in the template repository.
[% filter trim %][% include "snakemake-workflow-template/.gitignore" %][% endfilter %]
# % endif
# % if gitignore_own
# ~
# This repository's own, the gitignore_own answer in .copier-answers.yml.
