# Assembled by copier from github/gitignore; the source files are in the
# template repository, not here. A path of this repository's own is the
# gitignore_own answer in .copier-answers.yml, rendered at the end.

# vale's StylesPath, which .vale.ini sets and the sync hook fills on every
# repository whatever its languages; the Python and C++ blocks below name the
# same directory, the others do not.
.cache/
{%- if has_python %}

{% filter trim %}{% include "gitignore/Python.gitignore" %}{% endfilter %}

# Upstream covers .hypothesis, .pytest_cache, .coverage and htmlcov. It names
# none of the measurement tools, which write into the working directory and so
# left untracked output after every profiling or mutation run. Each name below
# comes from the tool rather than from a guess. `scalene --help` documents
# `scalene run` as saving to scalene-profile.json. pytest-benchmark's usage
# page gives file://./.benchmarks as the --benchmark-storage default, written
# when a run is saved for a later comparison. cosmic-ray takes its session
# database as an argument rather than defaulting to one, and session.sqlite is
# the name verification.md uses.
scalene-profile.json
.benchmarks/
session.sqlite
# pytest-testmon's dependency database, which its documentation names and
# which it rewrites on every run. It records this machine's paths, so it is
# local state rather than anything to share.
.testmondata
{%- endif %}
{%- if has_cpp %}

{% filter trim %}{% include "gitignore/C++.gitignore" %}{% endfilter %}

{% filter trim %}{% include "gitignore/CMake.gitignore" %}{% endfilter %}
{%- endif %}
{%- if has_latex %}

{% filter trim %}{% include "gitignore/TeX.gitignore" %}{% endfilter %}

# memoize externalises each memoised graphic to its own PDF and records the
# hashes beside it, so a build leaves a .mmz file and a .memo.dir tree of .memo
# and .pdf pairs. github/gitignore's TeX template predates the package and names
# none of them.
*.mmz
*.memo
*.memo.dir/
{%- endif %}
{%- if has_snakemake %}

# github/gitignore has no Snakemake template. The workflow catalog's own
# snakemake-workflow-template publishes this block, vendored unedited under
# snakemake-workflow-template/ in the template repository.
{% filter trim %}{% include "snakemake-workflow-template/.gitignore" %}{% endfilter %}
{%- endif %}
{%- if gitignore_own %}

# This repository's own, the gitignore_own answer in .copier-answers.yml.
{%- for path in gitignore_own %}
{{ path }}
{%- endfor %}
{%- endif %}
