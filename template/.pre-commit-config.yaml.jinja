# Hooks.
#
# The selection follows the Scientific Python Development Guide, whose own
# template publishes this file at
# scientific-python/cookie/{{cookiecutter.project_name}}/.pre-commit-config.yaml.
# sp-repo-review implements the guide as checks, so the result is measurable:
# run `uvx --from 'sp-repo-review[cli]' repo-review .` against a generated
# repository. Every revision below is set by `pre-commit autoupdate` rather
# than typed, and Dependabot's pre-commit ecosystem moves them afterwards.
#
# What the guide does not cover is prose, which the vale block at the end adds.

# % if precommit_exclude_own
# The precommit_exclude_own answer, paths only this repository holds that no
# hook should read or rewrite, such as third-party sources kept verbatim or a
# chezmoi source directory's Go templates.
# % endif
# The pattern is read in verbose mode, one alternative to a line, and
# .copier-answers.yml is copier's own record, rewritten on every update.
exclude: |
  (?x)^(
    \.copier-answers\.yml
    # % for pattern in precommit_exclude_own
    |(( pattern ))
    # % endfor
  )$

# pre-commit install puts in only the pre-commit stage unless told otherwise,
# and the hooks below that run at commit-msg are silent until it is. Listing
# both here is the documented way to make one `pre-commit install` enough.
default_install_hook_types: [pre-commit, commit-msg]

# A hook with no stages of its own runs at every stage installed above, which
# pre-commit's documentation gives as the default, so each file hook also ran
# at commit-msg with the message file as its argument. A linked worktree
# passes that file by absolute path, outside the tree: the colon after the
# Windows drive letter failed check-illegal-windows-names, and prettier
# refused a path it could not match, on every commit made from one. The file
# hooks run at pre-commit, and the message hooks name commit-msg themselves.
default_stages: [pre-commit]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-added-large-files
      - id: check-case-conflict
      - id: check-executables-have-shebangs
      - id: check-illegal-windows-names
      - id: check-merge-conflict
      - id: check-shebang-scripts-are-executable
      - id: check-symlinks
      - id: check-vcs-permalinks
      - id: check-xml
      # No check-yaml, check-toml or check-json: yamllint, taplo and prettier
      # parse every file of those types below and each fails on a syntax
      # error, measured by handing each a truncated file, so the three were
      # a second parse reporting a subset of the first.
      - id: destroyed-symlinks
      - id: forbid-submodules
      # % if has_python
      # The mutants session and testmon find a module's tests at
      # tests/test_<module>.py, and pytest collects test_*.py alone, so a test
      # file named any other way is silently never run. This is the hook that
      # says so; --pytest-test-first is the test_ prefix.
      - id: name-tests-test
        args: ["--pytest-test-first"]
      # % endif
      # The hook's default, --fix=auto, rewrites a file that mixes endings and
      # leaves one that is consistent. .editorconfig declares each file's
      # ending and editorconfig-checker enforces it: CRLF for .bat, .cmd and
      # .ps1, and whatever tex-fmt writes for .tex, .sty and .cls. --fix=lf
      # rewrote a CRLF .bat that both of those then failed.
      - id: mixed-line-ending
      - id: trailing-whitespace
        args: ["--markdown-linebreak-ext=md,mdx"]
      - id: end-of-file-fixer
        # % if has_generated_changelog
        # A generated CHANGELOG.md ends as its template does, and stripping
        # that makes the drift check fail on the next regeneration.
        exclude: ^CHANGELOG\.md$
        # % endif
        # ~
  # The guide's answer to formatting everything that is not Python: one
  # formatter across yaml, markdown, json and the web languages, rather than a
  # rule per file type argued out by hand.
  # % if has_node
  # The hook's own file selection, `types: [text]` with prettier's
  # --ignore-unknown, is kept: prettier decides from the extension and
  # .prettierignore what it formats. The guide's list below names no
  # TypeScript, and identify, which pre-commit filters with, has no tag for
  # .mts, .cts or .jsonc, so a list could not name them.
  # % endif
  - repo: https://github.com/rbubley/mirrors-prettier
    rev: v3.9.6
    hooks:
      - id: prettier
        # % if not has_node
        types_or: [yaml, markdown, html, css, scss, javascript, json]
        # % endif
        # % if has_generated_changelog
        # CHANGELOG.md is git-cliff's output, and prettier rewrapped its
        # paragraphs and split its list items on the first regeneration, which
        # the release workflow would then undo.
        exclude: ^CHANGELOG\.md$
        # % endif
      # % if is_template
      # The template's YAML and Markdown sources: the Jinja delimiters keep a
      # YAML source valid YAML, and the .jinja overrides in .prettierrc.yaml
      # name each parser, so a source is formatted as the file it renders.
      # The source patterns here allow a suffix without a dot between the
      # extension and .jinja, which is the closing tag of a file rendered
      # only for some answers, written as a class so Jinja reads no tag.
      - id: prettier
        alias: prettier-sources
        name: prettier on the template sources
        types: [text]
        files: ^template/.*\.(ya?ml|md)[^./]*\.jinja$
      # % endif
      # ~
  # taplo formats TOML, which prettier does not read: pyproject, ruff, typos,
  # lychee and cliff. uv.lock is uv's own output; taplo's defaults leave lock
  # files alone even when handed the path, so nothing here says so.
  - repo: https://github.com/ComPWA/taplo-pre-commit
    rev: v0.9.3
    hooks:
      - id: taplo-format

  # Capitalisation of the names of the tools themselves, which no linter has an
  # opinion about and everyone gets wrong. The word boundaries keep an
  # identifier that contains a name, such as \faGithub, from matching.
  # % if has_latex
  # A citation key is an identifier generated from a title, so
  # harrisArrayProgrammingNumpy2020 is camel case by construction, and a .bib
  # is left out for the reason _typos.toml leaves it unchecked.
  # % endif
  # % set caps_exclude = "\\.pre-commit-config\\.yaml(\\.jinja)?$" ~ ("|\\.bib$" if has_latex else "")
  - repo: local
    hooks:
      - id: disallow-caps
        name: Disallow improper capitalization
        language: pygrep
        entry: \b(PyBind|Numpy|Cmake|CCache|Github|PyTest)\b
        exclude: (( caps_exclude ))
  # % if has_python and not track_benchmarks
  # ~
  # A hand-written timing harness is the rule most often broken here, and it
  # was broken twice by writing a plausible file rather than by arguing with
  # the prose in verification.md. A sentence that asks is not a check that
  # fails, so this is the check. pre-commit's fail language exists to forbid a
  # file by name: the entry below is printed when the pattern matches.
  #
  # pyperf timeit measures without a file at all. The fixture this would hold
  # is read a second time only by the workflow track_benchmarks renders, and
  # this repository answered that false, so nothing would ever run the file.
  - repo: local
    hooks:
      - id: no-benchmark-harness
        name: benchmark harnesses are not written by hand
        # A literal block: prettier reflows a folded one to its own width and
        # rewrote this file on the first commit of every rendered repository.
        entry: |-
          A pyperf timeit line answers this without a file. See the benchmark
          section of verification.md. Answer track_benchmarks true if the
          number has to be rechecked in CI.
        language: fail
        files: ^tests/test_benchmark_.*\.py$
  # % endif
  # % if has_python
  # ~
  # The Scientific Python Development Guide, checked rather than remembered.
  # pyproject.toml's ruff selection is that guide's, and a selection copied into
  # a file is a list that drifts. This hook names every rule the guide asks for
  # that the repository has not selected, along with the rest of its checks, so
  # the drift is reported instead of waiting to be noticed. --show=err, which
  # the hook passes itself, prints the failures alone. It is published by
  # scientific-python/cookie, the guide's own template.
  - repo: https://github.com/scientific-python/cookie
    rev: 2026.08.14
    hooks:
      - id: sp-repo-review

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.16.6
    hooks:
      - id: ruff-check
        args: ["--fix", "--show-fixes"]
      - id: ruff-format

  # pydoclint compares each docstring's Args, Returns, Raises and Attributes
  # sections with the signature and body, which ruff's stable pydocstyle rules
  # do not, and ruff's own DOC port is preview-only. pydoclint reads
  # [tool.pydoclint] from pyproject.toml by itself, so the docstring style
  # stays in the file a repository already owns.
  - repo: https://github.com/jsh9/pydoclint
    rev: 0.9.1
    hooks:
      - id: pydoclint

  # uv's own hook refuses a commit whose uv.lock no longer matches
  # pyproject.toml, so the lock file the CI jobs sync from is never stale.
  - repo: https://github.com/astral-sh/uv-pre-commit
    rev: 0.12.11
    hooks:
      - id: uv-lock

  # mirrors-mypy builds an environment holding mypy alone, where a decorator
  # from pytest, hypothesis or nox resolves to Any. strict mode's
  # disallow_untyped_decorators then reports one error per decorated function,
  # 19 of them in the first repository to run this and none a type error in the
  # code. The same tree checked inside the environment uv syncs reports
  # `Success: no issues found in 11 source files`.
  #
  # `uv run --with mypy` syncs the project and adds the checker to it, which
  # works in a repository whose dependency group names mypy and in one that
  # declares no group at all, as the pyproject.toml rendered beside this file
  # does not. A rev with additional_dependencies would be a second copy of the
  # dependencies uv.lock already pins, and it would drift from them.
  #
  # The hook is handed the staged Python files rather than the tree. pre-commit
  # stashes unstaged edits to tracked files while the hooks run and leaves
  # untracked files in place, so a check over the tree read an untracked test
  # against a stashed edit to the module it imports and failed every commit
  # until both were staged together. Over the staged files it checks what the
  # commit contains, and the CI job runs the hook with --all-files.
  #
  # Still at the manual stage, since a hook that fails every commit touching
  # Python is a gate with nothing behind it until the tree is clean.
  # `pre-commit run mypy --hook-stage manual --all-files` runs it on demand,
  # and a repository that reports no errors deletes the stages line.
  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: uv run --with mypy mypy
        language: system
        types_or: [python, pyi]
        require_serial: true
        stages: [manual]

  # pyright reports no errors in its standard mode on the first repository to
  # take this hook, so it gates the commit from the start. Static checkers found
  # 29 of 40 real type bugs once code was annotated, against 14 before, and
  # their checking strategies differ (Xu et al., doi:10.1109/icpc58990.2023.00039),
  # so pyright runs beside mypy rather than instead of it. The hook's own
  # environment cannot see the project's packages, and pyright-python's README
  # fixes that by naming the project's virtual environment in [tool.pyright].
  # CI runs the hook in the Python workflow, after uv has synced it.
  - repo: https://github.com/RobertCraigie/pyright-python
    rev: v1.1.414
    hooks:
      - id: pyright

  - repo: https://github.com/abravalheri/validate-pyproject
    rev: "0.26"
    hooks:
      - id: validate-pyproject
        additional_dependencies: ["validate-pyproject-schema-store[all]"]
  # % endif
  # ~
  # The hook selects notebooks by type, so a repository without one skips it.
  - repo: https://github.com/kynan/nbstripout
    rev: 0.9.1
    hooks:
      - id: nbstripout
  # % if has_cpp
  # ~
  - repo: https://github.com/pre-commit/mirrors-clang-format
    rev: v23.1.0
    hooks:
      - id: clang-format
        types_or: [c++, c, cuda]

  # gersemi formats CMake through the hook its README gives, in place, and
  # reads the width from .gersemirc beside the sources. cmakelang stood here
  # as a local hook: it published none of its own and has had no release
  # since 0.6.13 in 2020.
  - repo: https://github.com/BlankSpruce/gersemi-pre-commit
    rev: 0.29.1
    hooks:
      - id: gersemi
  # % endif
  # % if has_latex
  # ~
  # tex-fmt is the LaTeX formatter. pre-commit bootstraps the rust toolchain
  # that builds it, so nothing is installed by hand, and its defaults hold:
  # two-space indentation and wrapping at 80 columns, which .editorconfig
  # states for editorconfig-checker. bibtex-tidy owns .bib below, so that type
  # is kept from tex-fmt: the two wrap a long field differently and each undid
  # the other on every run while both had the file.
  - repo: https://github.com/WGUNDERWOOD/tex-fmt
    rev: v0.5.7
    hooks:
      - id: tex-fmt
        exclude_types: [bib]

  # bibtex-tidy is the BibTeX formatter, run as its README's hook recipe.
  # --curly writes every field value in braces, so an entry pasted with
  # quotation marks reads like the rest.
  - repo: https://github.com/FlamingTempura/bibtex-tidy
    rev: v1.14.0
    hooks:
      - id: bibtex-tidy
        args: [--curly]

  # chktex is part of every TeX Live, so the hook runs the installed one and
  # reads .chktexrc from the working directory, which is where chktex looks.
  # The manual stage keeps it off the commit path; `pre-commit run chktex
  # --hook-stage manual --all-files` runs it on demand.
  - repo: local
    hooks:
      - id: chktex
        name: chktex
        entry: chktex --quiet --inputfiles=0
        language: system
        files: '\.tex$'
        stages: [manual]
  # % endif
  # ~
  # Schemas rather than opinions: each of these is the published schema for the
  # file it reads, so a workflow or a Dependabot configuration that GitHub
  # would reject fails here instead.
  - repo: https://github.com/python-jsonschema/check-jsonschema
    rev: "0.38.0"
    hooks:
      - id: check-dependabot
      - id: check-github-workflows
      # % if is_template
      # The workflow sources, read as the workflows they render: the .jinja
      # ones and the ones copied verbatim, which the hook above misses since
      # its pattern anchors at .github/workflows. The Dependabot source is
      # left out: its schedule is written by a Jinja loop, which the schema
      # reads as a key named after the loop variable until rendered.
      - id: check-github-workflows
        alias: check-github-workflows-sources
        name: Validate the workflow sources
        # check-jsonschema reads a file's type from its extension and falls
        # back to JSON; the option names YAML for a .jinja path.
        args: ["--default-filetype", "yaml"]
        types: [text]
        files: ^template/\.github/workflows/[^/]+\.ya?ml([^./]*\.jinja)?$
      # % endif
      # ~
  # zizmor reports at every severity, as zizmor-action does, so the hook and
  # code scanning agree. A finding that cannot be fixed yet is ignored where
  # it occurs with zizmor's `# zizmor: ignore[audit]` comment and its reason,
  # which zizmor still counts as ignored: self-repository asks for GitHub's
  # `$/` form, which actionlint 1.7.12 rejects (rhysd/actionlint#711, #732),
  # so each `uses: ./` line carries one until actionlint accepts `$/`. A
  # severity threshold hid every other low finding, and a disabled audit is
  # left out of zizmor's counts, which its documentation calls a last resort.
  # --fix applies the fixes zizmor marks safe, and pre-commit fails the
  # commit on the rewritten file, so each fix is reviewed in the diff. args
  # replaces the hook's own list, which is --no-progress alone, so that flag
  # is repeated.
  - repo: https://github.com/zizmorcore/zizmor-pre-commit
    rev: v1.30.0
    hooks:
      - id: zizmor
        args: ["--no-progress", "--fix"]
      # % if is_template
      # zizmor reads a .yml path wherever it is and refuses any other suffix
      # as invalid input, so the sources it reads are the workflows copied
      # verbatim; a .jinja workflow is read by actionlint and the schema.
      - id: zizmor
        alias: zizmor-sources
        name: zizmor on the workflow sources
        args: ["--no-progress", "--fix"]
        files: ^template/\.github/workflows/[^/]+\.ya?ml$
      # % endif
      # ~
  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.12
    hooks:
      - id: actionlint
      # % if is_template
      - id: actionlint
        alias: actionlint-sources
        name: actionlint on the workflow sources
        types: [text]
        files: ^template/\.github/workflows/[^/]+\.ya?ml([^./]*\.jinja)?$
      # % endif
      # ~
  # yamllint finds .yamllint.yaml in the working directory by itself, ahead
  # of a YAMLLINT_CONFIG_FILE in the environment, so the hooks name no file.
  - repo: https://github.com/adrienverge/yamllint
    rev: v1.38.0
    hooks:
      - id: yamllint
        args: ["--strict"]
      # % if is_template
      - id: yamllint
        alias: yamllint-sources
        name: yamllint on the template sources
        args: ["--strict"]
        types: [text]
        files: ^template/.*\.ya?ml[^./]*\.jinja$
      # % endif
  # % if is_template
  # ~
  # The hook source itself, read by `pre-commit validate-config`, the check
  # pre-commit runs on a rendered configuration. pre-commit publishes a hook
  # for a manifest and none for a configuration, so the command runs from
  # its own package in a hook environment.
  - repo: local
    hooks:
      - id: validate-config-source
        name: pre-commit validate-config on the hook source
        entry: pre-commit validate-config
        language: python
        additional_dependencies: [pre-commit]
        files: ^template/\.pre-commit-config\.yaml\.jinja$
  # % endif
  # ~
  - repo: https://github.com/DavidAnson/markdownlint-cli2
    rev: v0.23.2
    hooks:
      - id: markdownlint-cli2
  # ~
  # shfmt reads .editorconfig for its indent and style when given no flags,
  # so the shell scripts follow the same file every other language does.
  - repo: https://github.com/scop/pre-commit-shfmt
    rev: v3.13.1-1
    hooks:
      - id: shfmt

  - repo: https://github.com/shellcheck-py/shellcheck-py
    rev: v0.11.0.1-1
    hooks:
      - id: shellcheck

  # .editorconfig is read by every editor and by prettier; this is the check
  # that the tree agrees with it, which three repositories carried by hand.
  # max_line_length is set in .editorconfig only for prettier to read, and
  # prettier's options documentation calls its print width a target rather
  # than a limit: a string literal or a TeX label longer than the width stays
  # on one line. The checker reads the same key as a hard limit, and on the
  # first Node repository it reported 156 such lines after prettier had run,
  # each fixable only by an inline disable comment, so its line-length check
  # is switched off.
  - repo: https://github.com/editorconfig-checker/editorconfig-checker
    rev: v4.0.1
    hooks:
      - id: editorconfig-checker
        args: ["-disable-max-line-length"]

  # The hook's own args stand, --write-changes and --force-exclude. typos
  # writes a correction only where it knows exactly one and reports the rest,
  # and pre-commit fails the commit on the rewritten file, so each correction
  # is reviewed in the diff. A word it gets wrong goes in _typos.toml, which
  # is where the typos documentation puts a false positive.
  # `pre-commit autoupdate` moves this to the floating v1, which is never
  # re-resolved after the first install and warns on every commit thereafter.
  # An immutable tag is the point of pinning, so the version stays exact and
  # Dependabot's pre-commit ecosystem moves it.
  - repo: https://github.com/crate-ci/typos
    rev: v1.50.1
    hooks:
      - id: typos

  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks

  # commitlint at the commit, reading commitlint.config.mjs, the file the
  # Commit Lint workflow reads. conventional-pre-commit stood here before and
  # carried its own grammar: it passed an 89 column header and a body with no
  # blank line after the subject, both of which that config rejects, so the
  # rules were enforced on the pull request and not at the commit. The hook is
  # commitlint's own CLI under pre-commit's node language, and the shared
  # configuration the config extends is installed beside it, which is what the
  # hook's README asks for.
  - repo: https://github.com/alessandrojcm/commitlint-pre-commit-hook
    rev: v9.26.0
    hooks:
      - id: commitlint
        stages: [commit-msg]
        additional_dependencies: ["@commitlint/config-conventional"]

  # ASCII in the commit message, which CONTRIBUTING.md asked for and no hook
  # checked: commitlint has no rule for it and the vale styles look for words.
  # pygrep matches the message file as bytes, so the pattern is any byte above
  # the ASCII range. The tree is not held to this: every repository already
  # tracks a file with an accented name in it.
  - repo: local
    hooks:
      - id: ascii-commit-message
        name: ASCII in the commit message
        language: pygrep
        entry: '[^\x00-\x7F]'
        stages: [commit-msg]

  # Prose, which the guide does not cover. The hook entry is the bare vale
  # command, so it installs nothing the configuration names; the first entry
  # runs `vale sync` for that, which the packages documentation says to do
  # before linting. --config names this repository's .vale.ini, and vale reads
  # that flag ahead of a VALE_CONFIG_PATH in the environment, which --no-global
  # alone does not stop: a user-level path exported there replaced the
  # repository's styles and failed files a runner passed. --no-global keeps
  # the user-level file out as well, so the hook reports the same thing here
  # as on a runner.
  - repo: https://github.com/errata-ai/vale
    rev: v3.20.0
    hooks:
      # vale's own pre-commit recipe: sync runs whenever the hooks run, so the
      # styles .vale.ini names are present on a runner that checks only the
      # files a pull request changed and in a fresh clone, neither of which
      # a sync keyed on .vale.ini changing ever reached. It names both stages,
      # so the styles are present when the message is checked even for a
      # commit that stages no file.
      - id: vale
        alias: vale-sync
        name: vale sync
        args: [--config=.vale.ini, sync]
        pass_filenames: false
        stages: [pre-commit, commit-msg]
      # Vale parses MDX natively from v3.18.0, JSX children included from
      # v3.19.0, so MDX is prose here with no package to read it.
      - id: vale
        args: [--config=.vale.ini, --no-global, --minAlertLevel=error, --output=line]
        types_or: [markdown, mdx]
      # The commit message, at the stage git hands it over. .vale.ini reads
      # the message file as Markdown and layers ai-tells and ai-tells-commits
      # on it, as the vale-ai-tells README does. Among what they catch are the
      # co-author trailers and generated-with lines a tool appends. Claude Code
      # turns those off through its attribution settings, and this catches a
      # machine where that setting is missing, with upstream's vocabulary
      # rather than a pattern typed here.
      - id: vale
        alias: vale-commit-message
        name: vale on the commit message
        args: [--config=.vale.ini, --no-global, --minAlertLevel=error, --output=line]
        stages: [commit-msg]
