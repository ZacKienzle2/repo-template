# Project prose configuration. This file is identical in Orderbooks,
# Portfolio-Optimisation, Markets and Thesis, so the prose gate reports the
# same thing in every repository and on a runner.
#
# Vale needs a configuration file to run at all. It searches the working
# directory upwards and then the home directory, and a runner has neither the
# repository's rules nor the user-level file in the operating system config
# directory, so the hook stopped with "E100 [.vale.ini not found]" until this
# file existed. `vale sync` installs what Packages names, and the sync hook in
# .pre-commit-config.yaml runs it whenever this file changes, which the
# packages documentation says to do before linting.
#
# Style. proselint is selected rather than tuned. Measured over the tracked
# markdown in the four repositories at error level, the personal style set
# reports 798, 147, 244 and 1316 alerts and would refuse a commit touching 56
# of 58, 41 of 49, 36 of 38 and most thesis documents, for prose written long
# before the change. ai-tells accounts for nearly all of it: it is built to
# catch the fingerprints of machine-written prose, and its transition,
# semicolon and tricolon rules fire on correct formal English. proselint,
# which is sourced from named usage authorities, reports 3, 1, 3 and 0, and
# every one of those was a real defect that has been corrected.
#
# The personal styles still apply to newly written prose, through the editor
# hook that checks each file as it is saved. What they do not do any longer is
# gate a whole repository on documents nobody is editing.

StylesPath = .cache/vale/styles
MinAlertLevel = suggestion

# ai-tells-commits is not in Vale's package catalog, so it installs by URL, in
# the unpinned /releases/latest/download form the catalog uses for every other
# entry, so a new upstream release arrives on the next sync.
Packages = proselint, https://github.com/tbhb/vale-ai-tells/releases/latest/download/ai-tells-commits.zip{% if has_adrs %}, https://github.com/tbhb/vale-ai-tells/releases/latest/download/ai-tells.zip{% endif %}

# The commit message file has no extension. Read as Markdown, which is what a
# commit message is.
[formats]
COMMIT_EDITMSG = md

# Markdown alone. Vale has no LaTeX grammar and reads .tex comments and math
# as prose, which is textidote's job, and the .txt files in these repositories
# are verbatim third-party documents rather than anyone's writing. Both are
# left out by not being handed to Vale rather than by a list of excluded
# paths.
[*.md]
BasedOnStyles = proselint
# The same missing math grammar reaches Markdown. Vale reads $\tilde{V}(C)$
# and $\eta_T(r)$ as the registered and copyright marks, and the rule has no
# way to tell those from the real thing. It stays visible while writing and
# stops failing a commit.
proselint.Typography = warning
{%- if has_adrs %}

# Architecture decision records are the one body of prose here that is written
# now rather than inherited, so the full ai-tells set applies to them. The
# reasoning in the Style note above is about gating whole repositories of older
# writing, and it does not apply to a directory whose every file is current.
#
# The rules turned off below are turned off on the style's own advice. Each of
# their messages names the domain it misfires on, and this is that domain. An
# array shape is a shape, a sample that falls inside an acceptance region is
# the standard phrasing for rejection sampling, a cache entry that survives a
# rebuild is process-lifecycle prose, and a decision record exists to say what
# an implementation implements. The two punctuation rules fire on the colon in
# a paper title and on the semicolon separating two citations, neither of which
# is the AI punctuation the rule looks for.
[docs/adr/*.md]
BasedOnStyles = proselint, ai-tells
proselint.Typography = warning
ai-tells.FormalRegister = NO
ai-tells.FigurativeShape = NO
ai-tells.FigurativeFalls = NO
ai-tells.MortalityMetaphors = NO
ai-tells.BareHolds = NO
ai-tells.ColonUsage = NO
ai-tells.SemicolonUsage = NO

# MADR ships the template and the directory README. Both are upstream files, so
# they are read rather than written here, and a prose rule firing on them would
# ask for an edit that the next template update reverts.
[docs/adr/{adr-template,README}.md]
BasedOnStyles = proselint
proselint.Typography = warning
{%- endif %}
{%- if has_generated_changelog %}

# A generated CHANGELOG.md is the commit history rendered by git-cliff, and a
# commit message is checked when it is written; a usage rule firing on a
# subject line long after would refuse every regeneration. An empty
# BasedOnStyles is Vale's own way to hand a file no style.
[CHANGELOG.md]
BasedOnStyles =
{%- endif %}

# The message git hands the commit-msg hook, at both paths pre-commit passes.
# One published rule: the co-author trailers and generated-with lines a tool
# appends, which are not acceptable on a public repository. Naming the rule
# without its style loads it alone, so the style's other fourteen rules on
# tense, hedging and file listing stay out of the gate.
[{COMMIT_EDITMSG,.git/COMMIT_EDITMSG}]
ai-tells-commits.CommitAttribution = error
